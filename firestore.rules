rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registrations collection - Open for student applications & admin review
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // Students collection - Available for mosque administration, teachers, and student lookup
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Circles collection
    match /circles/{circleId} {
      allow read, write: if true;
    }

    // Quran Memorization records
    match /memorization_records/{recordId} {
      allow read, write: if true;
    }

    // Attendance records
    match /attendance_records/{attendanceId} {
      allow read, write: if true;
    }

    // Points and rewards ledger
    match /points_ledger/{pointId} {
      allow read, write: if true;
    }

    // Student files metadata
    match /student_files/{fileId} {
      allow read, write: if true;
    }

    // Global settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Users and Admins collection
    match /users/{userId} {
      allow read, write: if true;
    }

    match /admins/{userId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
